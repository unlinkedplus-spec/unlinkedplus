# Unlinked+ API configuration
# Copy to apps/api/.env and fill in real values before running.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unlinkedplus?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_openssl_rand_hex_32_min_48_chars
FRONTEND_URL=http://localhost:3000
STORAGE_PATH=./storage
COOKIE_SECURE=false
PAYMENT_MODE=disabled

# Account recovery
# disabled | console | webhook
MAIL_DRIVER=disabled
# Required only when MAIL_DRIVER=webhook
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=unlinked+ <noreply@unlinkedplus.local>
# Optional but recommended: deterministic pepper for email hashing.
# Keep this stable — changing it invalidates existing email hashes.
EMAIL_HASH_PEPPER=

# Salin ke .env lalu isi dengan nilai kuat. Jangan commit .env.
DB_PASSWORD=changeme_strong_db_password
REDIS_PASSWORD=changeme_strong_redis_password
JWT_SECRET=changeme_jwt_secret_min_64_chars_replace_with_openssl_rand_hex_32
EMAIL_HASH_PEPPER=changeme_pepper_min_32_chars

# Jika ADMIN_PASSWORD tidak diisi, seed membuat password admin 48-hex dan
# mencetaknya sekali saat seed berjalan. Akun non-admin bernama "admin"
# tidak pernah dipromosikan.
# ADMIN_PASSWORD=

JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
PAYMENT_MODE=disabled
NEXT_PUBLIC_API_URL=http://192.168.1.8/api
FRONTEND_URL=http://192.168.1.8
NODE_ENV=production
STORAGE_PATH=/data
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CMS Admin
ADMIN_API_KEY=changeme_admin_key_min_32_chars

# Penyimpanan
MAX_UPLOAD_SIZE_MB=5

# Password recovery: disabled | console | webhook
# disabled = tidak ada email dikirim (emailSent=false); pakai kode pemulihan.
MAIL_DRIVER=disabled
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=
# MAIL_FROM=unlinked+ <noreply@unlinkedplus.local>

# Publisher cerita terjadwal (ms)
SCHEDULED_PUBLISH_INTERVAL_MS=30000

# Binding host (default loopback; VPS bisa 0.0.0.0:80 bila diinginkan)
# BIND_ADDRESS=127.0.0.1
# HTTP_PORT=8080

# Hanya untuk overlay monitoring VPS
# GRAFANA_ADMIN_PASSWORD=changeme_grafana_password
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3002
